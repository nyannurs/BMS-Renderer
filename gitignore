# ---- BMS Renderer .gitignore ----
# Share the source (bms_core.py, bms_renderer.py, player.py, README.md,
# requirements.txt, and the test suite). Everything below is either generated by
# the app, machine-specific, or personal data that shouldn't be published.

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environment (machine-specific, large) ---
venv/
.venv/
env/

# --- App-generated data (created next to the program at runtime) ---
bms_cache.db          # your scanned library index (large, personal)
bms_cache.db-wal      # SQLite write-ahead log
bms_cache.db-shm      # SQLite shared-memory file
bms_cache.json        # legacy cache, if present
bms_config.json       # your personal library/output paths + settings

# --- Your personal content (not for distribution) ---
Playlists/            # your saved playlists
Render/               # your rendered audio output
tables.json           # your tracked difficulty tables
# (delete the line above if you ever want to ship default tables with the app)

# --- Test files (kept local, not shipped) ---
Test Suite/
test_bms_core.py

# --- Removed / unwanted ---
run.bat               # broken launcher; just run `python bms_renderer.py`
*.bat

# --- Build artifacts (in case PyInstaller ever runs again) ---
build/
dist/
*.spec

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
